{
  "expo": {
    "name": "Comparely",
    "slug": "comparely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/ios-light.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.comparely.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icons/android-adaptive-icon.png",
        "backgroundColor": "#004738"
      },
      "package": "in.comparely.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icons/ios-light.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Comparely to use your location."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#004738"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Sora/static/Sora-Regular.ttf",
            "./assets/fonts/Sora/static/Sora-Bold.ttf",
            "./assets/fonts/Sora/static/Sora-ExtraBold.ttf",
            "./assets/fonts/Sora/static/Sora-Light.ttf",
            "./assets/fonts/Sora/static/Sora-ExtraLight.ttf",
            "./assets/fonts/Sora/static/Sora-Medium.ttf",
            "./assets/fonts/Sora/static/Sora-SemiBold.ttf",
            "./assets/fonts/Sora/static/Sora-Thin.ttf",
            "./assets/fonts/Sora/Sora.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
